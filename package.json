{
  "name": "@thekestongroup/ui",
  "version": "0.3.0",
  "description": "Keston UI — Vue 3 + Reka UI + Tailwind CSS component library",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekestongroup/ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "module": "./dist/keston-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/keston-ui.js"
    },
    "./theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "vue-tsc -b",
    "build-storybook": "storybook build",
    "new": "node scripts/new-component.mjs",
    "changeset": "changeset",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@11.6.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.68.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-bold": "^3.33.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-hard-break": "^3.33.1",
    "@tiptap/extension-italic": "^3.33.1",
    "@tiptap/extension-paragraph": "^3.33.1",
    "@tiptap/extension-text": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/vue-3": "^3.33.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/builder-vite": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
