{
  "name": "@thekestongroup/ui",
  "version": "0.1.2",
  "description": "Keston UI — Vue 3 + Reka UI + Tailwind CSS component library",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/keston-ui.cjs",
  "module": "./dist/keston-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/keston-ui.js",
      "require": "./dist/keston-ui.cjs"
    },
    "./style.css": "./dist/keston-ui.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
